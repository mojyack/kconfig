set arch amd64
include frag/general

# arch
include frag/arch/x86/amd64
CONFIG_CPU_SUP_INTEL=y
CONFIG_MSKYLAKE=y
CONFIG_NR_CPUS=4
CONFIG_X86_MCE_INTEL=y

# boot
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="root=PARTUUID=691a3db3-5de6-486b-8c79-be1300893eab rw loglevel=3 fsck.mode=skip"

include frag/arch/x86/efi
CONFIG_EFI_STUB=y

# thermal
CONFIG_INTEL_POWERCLAMP=m
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_INTEL_PCH_THERMAL=m
CONFIG_INTEL_TCC_COOLING=m

# hwmon
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_APPLESMC=m

# wdt
CONFIG_WATCHDOG=y
CONFIG_ITCO_WDT=m
CONFIG_ITCO_VENDOR_SUPPORT=y

# perf
CONFIG_PERF_EVENTS_INTEL_UNCORE=m
CONFIG_PERF_EVENTS_INTEL_RAPL=m
CONFIG_PERF_EVENTS_INTEL_CSTATE=m

# acpi
include frag/drivers/acpi
CONFIG_ACPI_EC=y
CONFIG_ACPI_AC=m
CONFIG_ACPI_BATTERY=m
CONFIG_ACPI_SBS=m
CONFIG_INTEL_IDLE=y

include frag/fs/nfs
include frag/extra/zram
include frag/extra/gentoo

### drivers ###
# pci
include frag/drivers/pci

# mfd
CONFIG_LPC_ICH=m
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_PMC_BXT=m

# i2c
CONFIG_I2C_I801=m

# spi
CONFIG_SPI=y
CONFIG_SPI_PXA2XX=m

# input
CONFIG_INPUT_UINPUT=m
CONFIG_KEYBOARD_APPLESPI=m
# iBridge config 1
CONFIG_HID_APPLE_IBRIDGE=m
CONFIG_HID_APPLE_IB_TB=m
CONFIG_HID_APPLE_IB_ALS=m
# iBridge config 2
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_APPLETB_BL=m

# char
CONFIG_SERIAL_8250=m
CONFIG_SERIAL_8250_DW=m  # for bluetooth
CONFIG_SERIAL_DEV_BUS=y  # CONFIG_BT_HCIUART_BCM
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y

# mei
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_ME=m
CONFIG_INTEL_MEI_HDCP=m
CONFIG_INTEL_MEI_PXP=m

# block
include frag/drivers/nvme
CONFIG_BLK_DEV_NVME=y  # root device

# ethernet
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_AX88179_178A=m

# wifi
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PROTO_MSGBUF=y
CONFIG_BRCMFMAC_PCIE=y

# bluetooth
include frag/net/wireless
include frag/net/bluetooth/uart
CONFIG_BT_HCIUART_BCM=y

# gpio
include frag/drivers/gpio

# gpu
include frag/drivers/drm/i915
CONFIG_DRM_I915=y
CONFIG_EXTRA_FIRMWARE="i915/skl_dmc_ver1_27.bin"
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"
CONFIG_DRM_APPLETBDRM=m

# sound
include frag/drivers/sound/hda
CONFIG_SND_HDA_CODEC_CIRRUS=m
CONFIG_SND_HDA_CODEC_CS8409=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_HDMI_INTEL=m

CONFIG_SND_SOC=m
CONFIG_SND_SOC_INTEL_AVS=m

include frag/drivers/sound/usb

# usb
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_ROLE_SWITCH=m
CONFIG_USB_ROLES_INTEL_XHCI=m

# rtc
include frag/drivers/rtc
CONFIG_RTC_DRV_CMOS=m

# dma
CONFIG_DMADEVICES=y
CONFIG_INTEL_IDMA64=m

# platform
CONFIG_INTEL_PMC_CORE=m
CONFIG_INTEL_PMT_CLASS=m
CONFIG_INTEL_PMT_TELEMETRY=m
CONFIG_INTEL_VSEC=m

# iio (for touchbar)
CONFIG_IIO=m
CONFIG_IIO_BUFFER=y
CONFIG_IIO_TRIGGERED_BUFFER=m
