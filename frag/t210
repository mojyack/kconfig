# arch
include arch/arm64/general
include arch/arm64/feats/armv8-1
include arch/arm64/feats/armv8-2
include arch/arm64/erratum/cortex-a57
CONFIG_ARM64_ERRATUM_834220=n  # !KVM

# !ARCH_NO_PREEMPT
CONFIG_PREEMPT_NONE=n
CONFIG_PREEMPT_LAZY=y

# Cortex-A57@4
CONFIG_ARCH_TEGRA=y
CONFIG_ARCH_TEGRA_210_SOC=y
CONFIG_NR_CPUS=4

CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_PA_BITS_48=y
CONFIG_CMA=y

# cpufreq
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_ARM_TEGRA124_CPUFREQ=y  # =y because of no modalias
CONFIG_TEGRA_CLK_DFLL=y
CONFIG_ARM_TEGRA_DEVFREQ=m
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=m  # gm20b clk

### drivers ###
# pci
include drivers/pci
CONFIG_PCI_TEGRA=m

# bus
CONFIG_TEGRA_ACONNECT=m  # for sound

# char
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_TEGRA=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_HW_RANDOM=m

# input
CONFIG_KEYBOARD_GPIO=m

# i2c
CONFIG_I2C_TEGRA=y
CONFIG_I2C_CHARDEV=m

# spi
CONFIG_SPI=y
CONFIG_SPI_TEGRA114=m
CONFIG_SPI_TEGRA210_QUAD=m
CONFIG_SPI_SPIDEV=m

# pinctrl
CONFIG_PINCTRL_TEGRA210=y
CONFIG_PINCTRL_MAX77620=y

# gpio
include drivers/gpio
CONFIG_GPIO_TEGRA=y
CONFIG_GPIO_MAX77620=y

# hwmon
CONFIG_SENSORS_PWM_FAN=m

# thermal
CONFIG_TEGRA_SOCTHERM=m
CONFIG_MAX77620_THERMAL=m

# mfd
CONFIG_MFD_MAX77620=y

# regulator
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_REGULATOR_PWM=m
CONFIG_REGULATOR_MAX77620=y
CONFIG_REGULATOR_MAX8973=m  # max77621, vdd-cpu/vdd-gpu rail

# media
CONFIG_DRM_TEGRA_NVDEC_V4L2=y

# gpu
CONFIG_TEGRA_HOST1X=m
## drm
CONFIG_DRM_TEGRA=m
include drivers/drm/nouveau
CONFIG_DRM_NOUVEAU=m  # firmware blobs in rootfs
CONFIG_NOUVEAU_PLATFORM_DRIVER=y

# sound
include drivers/sound/menu
CONFIG_SND_SOC=m
CONFIG_SND_SOC_TEGRA=m
CONFIG_SND_SOC_TEGRA210_AHUB=m
CONFIG_SND_SOC_TEGRA210_ADMAIF=m
CONFIG_SND_SOC_TEGRA210_I2S=m
CONFIG_SND_SOC_TEGRA210_DMIC=m
CONFIG_SND_SOC_TEGRA210_SFC=m
CONFIG_SND_SOC_TEGRA210_AMX=m
CONFIG_SND_SOC_TEGRA210_ADX=m
CONFIG_SND_SOC_TEGRA210_MIXER=m
CONFIG_SND_SOC_TEGRA210_MVC=m
CONFIG_SND_SOC_TEGRA210_OPE=m
CONFIG_SND_AUDIO_GRAPH_CARD=m
CONFIG_SND_SOC_TEGRA_AUDIO_GRAPH_CARD=m

# usb
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_TEGRA=y
CONFIG_PHY_TEGRA_XUSB=m
CONFIG_USB_CONN_GPIO=m
## gadget
CONFIG_USB_GADGET=m
CONFIG_USB_TEGRA_XUDC=m

# mmc
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_TEGRA=y

# rtc
include drivers/rtc
CONFIG_RTC_DRV_TEGRA=m
CONFIG_RTC_DRV_MAX77686=m

# dma
CONFIG_DMADEVICES=y
CONFIG_TEGRA20_APB_DMA=y  # =y for i2c-tegra
CONFIG_TEGRA210_ADMA=m

# common-clock
CONFIG_COMMON_CLK_MAX77686=m

# timer
CONFIG_TEGRA_TIMER=y

# iommu
CONFIG_IOMMU_SUPPORT=y
CONFIG_TEGRA_IOMMU_SMMU=y

# memory controller
CONFIG_MEMORY=y
CONFIG_TEGRA_MC=y
CONFIG_TEGRA210_EMC=m

# pwm
CONFIG_PWM=y
CONFIG_PWM_TEGRA=m

# pmu
CONFIG_ARM_PMU=y
