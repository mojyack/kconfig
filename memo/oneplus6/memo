# prepare mkbootimg
git clone --depth=1 https://github.com/osm0sis/mkbootimg.git
pushd mkbootimg
make CC=clang -j$(nproc)
popd

# prepare kernel
git clone --depth=1 https://gitlab.com/sdm845-mainline/linux.git -b sdm845/7.1-dev
pushd linux
## print firmware
curl 'https://732852.bugs.gentoo.org/attachment.cgi?id=649432' | patch -p1
## enable usb host mode
sed -i 's/dr_mode = "peripheral"/dr_mode = "host"/' arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi
## additional patches
patch -p1 < msm-dpu-supress-warnings.patch

mc usb1

# follow regular-update

kmake Image.gz && kmake modules && kmake dtbs && rkmake modules_install
popd

# install
~/build/kconfig/memo/oneplus6/create-boot-image.sh $W/arch/arm64/boot/{Image.gz,dts/qcom/sdm845-oneplus-enchilada.dtb} boot_m.img
doas cp boot_m.img /tmp/mnt/usb1/boot

# in target device
# write new image and reboot
doas dd if=/boot/boot_m.img of=/dev/disk/by-partlabel/boot_a bs=4096
doas sync
doas reboot
