# prepare mkbootimg
git clone --depth=1 https://github.com/osm0sis/mkbootimg.git
pushd mkbootimg
make CC=clang -j$(nproc)
popd

# prepare kernel
git clone "https://github.com/mojyack/linux.git" -t sdm845-develop
pushd linux

mc usb1

# follow regular-update

kmake Image.gz && kmake modules && kmake dtbs && rkmake modules_install
popd

# install
~/build/kconfig/memo/oneplus6/create-boot-image.sh $W/arch/arm64/boot/{Image.gz,dts/qcom/sdm845-oneplus-enchilada.dtb} boot_m.img
doas cp boot_m.img /tmp/mnt/usb1/boot

# in target device
# write new image and reboot
doas dd if=/boot/boot_m.img of=/dev/disk/by-partlabel/boot_a bs=4096
doas sync
doas reboot
