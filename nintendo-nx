set arch arm64
set kernel 7.3
include frag/general

include frag/fs/nfs
include frag/extra/zram

include frag/t210


### drivers ###
# net
include frag/net/wireless
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y

# usb net
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX88179_178A=m

# char
CONFIG_SERIAL_TEGRA=m
CONFIG_SERIAL_DEV_BUS=y  # SERIAL_DEV_CTRL_TTYPORT
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y  # required for bt!

# input
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_JOYCON=m
CONFIG_INPUT_UINPUT=m
CONFIG_INPUT_MAX77620_ONKEY=m
## touchscreen
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_STMFTS=m

# hid
CONFIG_UHID=m
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y

# gpu
## drm
CONFIG_DRM_PANEL_JDI_LPM062M326A=m
CONFIG_BACKLIGHT_PWM=m

# audio
CONFIG_SND_SOC_RT5640=m
## dp audio
CONFIG_SND_HDA_TEGRA=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_HDMI_TEGRA=m

# usb
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC=m
CONFIG_TYPEC_BM92TXX=m

# nvmem
CONFIG_NVMEM=y
CONFIG_NVMEM_SYSFS=y

# led
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=m  # CONFIG_TOUCHSCREEN_STMFTS

# extcon
CONFIG_EXTCON=y  # for type-c

# power supply
CONFIG_CHARGER_BQ24190=m
CONFIG_BATTERY_MAX17042=m

# hwmon
CONFIG_SENSORS_TMP401=m

# iio
CONFIG_IIO=m
CONFIG_BH1730=m

# bluetooth
include frag/net/bluetooth/uart
CONFIG_BT_HCIUART_BCM=y


### configs ###
CONFIG_TUN=m

# ramoops
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

